    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid Stealth Dark Background matching ChampZone Emblem -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#0F172A" />
                <item android:offset="0.5" android:color="#0B0E14" />
                <item android:offset="1.0" android:color="#05070B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Gaming Radial Halo behind Trophy -->
    <path
        android:pathData="M54,20 A34,34 0 1 0 54,88 A34,34 0 1 0 54,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="34"
                android:type="radial">
                <item android:offset="0.0" android:color="#26FFB300" />
                <item android:offset="0.7" android:color="#08FF8F00" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
